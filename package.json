{
  "name": "agentwiki-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,ts,json}\"",
    "check:bundle": "node scripts/check-bundle.mjs && node scripts/check-release.mjs",
    "check": "npm run check:format && npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@neomei/agentwiki-sync-protocol": "^0.1.0",
    "node-diff3": "^3.2.0",
    "unicode-case-folding": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "obsidian": "^1.11.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
